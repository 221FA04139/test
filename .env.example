# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Database — PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/financedb
# Railway: set automatically by Railway PostgreSQL plugin
DATABASE_URL=postgresql://user:password@localhost:5432/financedb

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-secret-key

# Flask environment
FLASK_ENV=production

# App version
APP_VERSION=1.0.0
